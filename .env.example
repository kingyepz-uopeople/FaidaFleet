NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Project Settings, then API Keys. Either name works. Set both in Vercel before building.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Lets a fleet owner create a driver phone login without signing themselves out.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only suffix added to 4- and 5-digit PINs before Supabase Auth stores
# them (Supabase requires passwords of at least 6 characters). 6-digit PINs are
# stored unchanged. Optional: a built-in fallback is used when absent, but set
# the same value in every environment and never change it after short PINs are
# in use, or those PINs will stop working. Keep it out of NEXT_PUBLIC_* vars.
PIN_PEPPER=replace-with-a-long-random-secret
# Screenshot/dev only. Never set this when real NEXT_PUBLIC_SUPABASE_* values are present.
# NEXT_PUBLIC_ADMIN_UI_PREVIEW=1
